// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String     @id @default(cuid())
  name     String?
  email    String     @unique
  password String
  trips    UserTrip[]
  comments Comment[]
  photos   Photo[]
  expenses Expense[]
  reviews  Review[]
}

model Trip {
  id             String       @id @default(cuid())
  title          String
  description    String?
  area           String?
  startDate      DateTime?
  endDate        DateTime?
  status         TripStatus   @default(PLANNING)
  inviteCode     String       @unique @default(cuid())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  participants   UserTrip[]
  stages         Stage[]
  /// Serialised chat messages: { role, content, pills? }[]
  chatState      Json?
  /// Extracted trip fields from the planning conversation
  planningFields Json?
  /// Claude-curated route suggestions: RouteSuggestion[]
  suggestions    Json?
  /// The single suggestion the user picked: RouteSuggestion
  selectedSuggestion Json?
  comments           Comment[]
  photos             Photo[]
  /// Packing list: PackItem[] persisted per trip
  packingList        Json?
  expenses           Expense[]
  reviews            Review[]
}

model UserTrip {
  userId    String
  tripId    String
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@id([userId, tripId])
}

model Comment {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Photo {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  data      Bytes
  mimeType  String
  fileName  String?
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Stage {
  id              String    @id @default(cuid())
  tripId          String
  dayNumber       Int
  date            DateTime?
  fromLocation    String
  toLocation      String
  distanceKm      Float?
  durationMinutes Int?
  elevationGainM  Int?
  elevationLossM  Int?
  hutId           String?
  hutName         String?
  notes           String?
  trip            Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum TripStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Expense {
  id            String   @id @default(cuid())
  tripId        String
  paidByUserId  String
  amount        Float
  description   String
  /// Optional list of participant userIds to split among; null = all accepted participants
  splitAmong    Json?
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy        User     @relation(fields: [paidByUserId], references: [id], onDelete: Cascade)
}

model Review {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  rating      Int      // 1–5
  tags        String[] // e.g. ["familievennlig","krevende"]
  content     String?
  season      String?  // snapshot of trip season when written
  groupSize   Int?     // snapshot of participant count when written
  tripDate    DateTime? // snapshot of trip start date
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}
